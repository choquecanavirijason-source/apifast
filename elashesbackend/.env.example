# =============================================================================
# Desarrollo local (Docker o python main.py)
# =============================================================================
# cp .env.example .env

APP_NAME="Elashes API"
APP_VERSION="1.0.0"

HOST="0.0.0.0"
PORT=8000
DEBUG=false

SECRET_KEY="cambia-esta-clave-en-desarrollo"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

DATABASE_URL="sqlite:///./elashes.db"

# Frontend local (Vite) o cualquier origen en dev
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# =============================================================================
# Marketplace (microservicioMarketplace — repo separado)
# =============================================================================
# Local sin Docker (python main.py):
#   MARKETPLACE_BACKEND_URL=http://localhost:8001
#
# Local con Docker (docker compose):
#   MARKETPLACE_BACKEND_URL=http://host.docker.internal:8001
#   (ya configurado en docker-compose.yml, no hace falta en .env)
#
# GCP (systemd, sin Docker):
#   MARKETPLACE_BACKEND_URL=http://localhost:8001
#   (ya en .env.gcp.example)
MARKETPLACE_BACKEND_URL=http://localhost:8001

# WhatsApp global (opcional)
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=webhook

# =============================================================================
# Producción en Google Cloud VM
# =============================================================================
# Usa la plantilla dedicada:
#   cp .env.gcp.example .env
# Ver: deploy/gcp/DEPLOY_GCP_UBUNTU.md
# Para el marketplace ver: deploy/gcp/DEPLOY_MARKETPLACE_GCP.md
