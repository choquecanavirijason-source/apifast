# Plantilla para Google Cloud VM (Ubuntu + systemd + nginx fullstack)
# En la VM:
#   cd /opt/elashes/apifast/elashesbackend
#   cp .env.gcp.example .env
#   nano .env   # cambia SECRET_KEY
#   sudo systemctl restart elashesbackend
#
# IP pública de la VM (consola GCP → Detalles de red): 34.55.150.142

# Configuración de la aplicación
APP_NAME="API MapFace"
APP_VERSION="1.0.0"
APP_DESCRIPTION="Una API REST desarrollada con FastAPI siguiendo arquitectura MVC"

# Configuración del servidor
HOST="0.0.0.0"
PORT=8000
DEBUG=false

# Configuración de seguridad
SECRET_KEY="cambia-esta-clave-en-produccion"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Base de datos
DATABASE_URL="sqlite:///./elashes.db"

# CORS (JSON array)
ALLOWED_ORIGINS=["http://34.55.150.142","https://34.55.150.142","http://localhost","http://127.0.0.1"]

# URL interna del backend_marketplace (el frontend ya no necesita llamarlo directo)
MARKETPLACE_BACKEND_URL=http://localhost:8001

# WhatsApp (opcional; también se puede configurar por sucursal en Salones)
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=webhook
# WHATSAPP_API_URL=
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
