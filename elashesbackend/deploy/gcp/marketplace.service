[Unit]
Description=Elashes Marketplace API
After=network.target elashesbackend.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/elashes/microservicioMarketplace
EnvironmentFile=/opt/elashes/microservicioMarketplace/.env
ExecStart=/opt/elashes/microservicioMarketplace/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001 --workers 1
Restart=always
RestartSec=3
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
